# Copy to .env.local for `npm run dev`. Under docker compose these are set by
# docker-compose.demo.yml and this file is only the reference.

# ------------------------------------------------------------------ appliance
# Where the demo reaches LegalMemory. Server-side only: the browser never talks
# to the appliance directly, so the MCP endpoint and the document blobs are not
# reachable from a page the demo happens to be open in.
LEGALMEMORY_API_URL=http://127.0.0.1:8010
# Defaults to LEGALMEMORY_API_URL + /mcp when unset.
LEGALMEMORY_MCP_URL=

# Who the demo is signed in as. The appliance enforces this identity on every
# tool call and every folder listing, so changing it changes what the demo can
# see — which is the point of showing it in the header.
#
# This is the trusted-header path, which requires
# KI_SECURITY__MCP_ALLOW_TRUSTED_HEADER=true on the appliance. That is a
# development and demo setting: anything that can reach the port can name itself
# any lawyer in the firm. A real deployment puts OIDC in front instead.
LEGALMEMORY_PRINCIPALS=role:admin

# ---------------------------------------------------------------------- model
# The model the chat runs on, by the name the gateway serves it under. Routed
# through LiteLLM so the demo needs no provider key of its own and its spend
# lands in the same cost centre as the rest of the appliance.
DEMO_MODEL=gemini-3.6-flash
DEMO_MODEL_BASE_URL=http://127.0.0.1:4000/v1
DEMO_MODEL_API_KEY=sk-lm-dev-only

# ----------------------------------------------------------------------- login
# Optional, both or neither. Present → every route requires a signed-in Clerk
# user. Absent → the demo runs open. See .env.demo.example at the repo root for
# where the credentials live.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
