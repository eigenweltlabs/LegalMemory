# Copy to .env and fill in every non-optional section. Required values are declared by
# docker-compose.yml with ${VAR:?}, so a missing one stops the stack with the name of what
# is missing rather than starting an appliance that fails on its first model call or
# writes backups nobody can open.
#
#   cp .env.example .env
#
# .env is gitignored and holds real keys. This file never does.

# ------------------------------------------------------------------ provider keys
# KI_-prefixed on purpose. Compose gives a shell variable precedence over .env, so a stale
# OPENAI_API_KEY exported in somebody's profile would silently shadow the file and the
# gateway would start with the wrong key — which presents as an unexplained 429 from the
# provider rather than as a configuration error.
KI_OPENAI_API_KEY=sk-your-openai-key
KI_SCW_SECRET_KEY=your-scaleway-secret-key

# ------------------------------------------------------------------------- models
# The two models this deployment runs. Nothing in the code or in
# deploy/litellm/config.yaml names a model — changing model is changing these lines.
# KI_*_MODEL is the name everything refers to it by (the appliance's slots, the gateway's
# registry, the cost centre); KI_*_UPSTREAM is the provider route it resolves to.
#
# Below is qwen on Scaleway. For OpenAI instead: set UPSTREAM to openai/<model>, leave
# API_BASE empty (OpenAI routes on the model prefix) and set API_KEY to the OpenAI key.
KI_LLM_MODEL=qwen3.6-35b-a3b
KI_LLM_UPSTREAM=openai/qwen3.6-35b-a3b
KI_LLM_API_BASE=https://api.scaleway.ai/YOUR-PROJECT-ID/v1
KI_LLM_API_KEY=your-scaleway-secret-key
# Per-token USD for the contracted rate. LiteLLM prices a call from its own cost map and
# has no entry for a self-hosted or newly-released model, which would report real tokens at
# zero cost — free work in the cost centre. Stated so it is never guessed.
# Scaleway qwen3.6-35b-a3b: $0.25 / 1M in, $1.50 / 1M out.
KI_LLM_INPUT_COST_PER_TOKEN=0.00000025
KI_LLM_OUTPUT_COST_PER_TOKEN=0.0000015

KI_EMBEDDING_MODEL=text-embedding-3-small
KI_EMBEDDING_UPSTREAM=openai/text-embedding-3-small
KI_EMBEDDING_API_KEY=sk-your-openai-key
# OpenAI list price, $0.02 / 1M tokens.
KI_EMBEDDING_INPUT_COST_PER_TOKEN=0.00000002

# ------------------------------------------------------------------------ secrets
# Encrypts stored connector credentials and, under the same envelope, the backup key and
# object-storage credentials an administrator sets in the console. Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Lose it and every stored OAuth token is undecryptable ciphertext and every connector has
# to be authorized again by hand.
KI_CONNECTOR_CREDENTIAL_KEY=generate-me-32-bytes-base64

# ------------------------------------------------ optional connector event delivery
# These lower Drive/SharePoint change latency. Leave them empty until the customer-owned
# Pub/Sub/Event Hubs setup in docs/operator-guide.md is complete; the continuous policy
# interval remains the reconciliation path when event delivery is not configured.
KI_GOOGLE_EVENTS_TOPIC=
KI_GOOGLE_EVENTS_PULL_SUBSCRIPTION=
KI_CONNECTOR_EVENTS_SECRET_DIR=./runtime/secrets
KI_GOOGLE_EVENTS_SERVICE_ACCOUNT_FILE=/run/connector-events/google-events.json
# Alternative to a mounted file. Never commit real service-account JSON.
KI_GOOGLE_EVENTS_SERVICE_ACCOUNT_JSON=

KI_MICROSOFT_EVENTS_NOTIFICATION_URL=
KI_MICROSOFT_EVENTS_NAMESPACE=
KI_MICROSOFT_EVENTS_EVENT_HUB=
KI_MICROSOFT_EVENTS_CONSUMER_GROUP='$Default'
KI_MICROSOFT_EVENTS_TENANT_ID=
KI_MICROSOFT_EVENTS_CLIENT_ID=
# Optional when CLIENT_ID is also used by an active SharePoint connection: the app
# reuses that connection's encrypted client secret. Required for a dedicated receiver.
KI_MICROSOFT_EVENTS_CLIENT_SECRET=

# Shared secret between the appliance and the helper that replaces Keycloak's and Hatchet's
# volumes during a restore. That helper holds the Docker socket; this is the only thing
# stopping anything else on the compose network asking it to use it. Generate it the same
# way, and do not ship the placeholder.
KI_RESTORE_AGENT_SECRET=generate-me-too

# ------------------------------------------------------------------------ backups
# Where full backups are written. The default is inside the repo, which survives
# `docker compose down -v` but is on the same machine — fine for trying the feature out,
# not a backup. Point this at the firm's NAS or an external disk.
KI_BACKUP_MOUNT=./runtime/backups

# The backup encryption key is NOT here. It is generated in the console under Backup, shown
# once, and held encrypted in the database — so there is one place it can come from and one
# copy to keep safe off this machine.
