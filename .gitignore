# cloned third-party repos for study — never committed; retain the pin manifest
external/*/

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# node
node_modules/
frontend/node_modules/
frontend/*.tsbuildinfo
ui/dist/

# runtime data — root only, so it never matches the benchmark package's committed
# data/ dir (frozen gold + firm-structure manifests, loaded at runtime by store.py)
/data/
.ki/
# Root-anchored: this is the appliance's runtime data directory. Unanchored it would
# also match src/knowledge_index/connectors/runtime/, which is source.
/runtime/
output/
.playwright-cli/
*.db
*.sqlite*
.env
.env.*
# The templates are the env files that must be committed: docker-compose.yml requires
# eleven variables outright, so a fresh clone cannot start the stack without it, and
# the demo stack has its own required set.
!.env.example
!.env.demo.example

# generated test corpora (regenerate with scripts, keep only small seeds)
testdata/generated/
testdata/harvey/
testdata/harvey-smoke/
retrieval-report.json

# os
.DS_Store
.gstack/

# Local-only self-signed TLS for the dev Keycloak (regenerate with scripts/…; never ship)
deploy/keycloak/tls/

# Scale-test output. The tooling that produced these was removed; the artifacts are
# regenerated locally and have been committed by accident more than once.
/scale-report.json
/testdata/scale/
