# Copy to .env.demo and fill in the provider keys.
#
#   cp .env.demo.example .env.demo
#   docker compose -f docker-compose.demo.yml --env-file .env.demo up -d --build
#
# Only the two model routes and one secret are required. Everything else has a
# demo-appropriate default, which is a different thing from a production-
# appropriate one — see the header of docker-compose.demo.yml for what this
# stack deliberately leaves out.

# --------------------------------------------------------------- appliance model
# The model the insertion pipeline runs on: classification, relations, extraction.
KI_LLM_MODEL=qwen3.6-35b-a3b
KI_LLM_UPSTREAM=openai/qwen3.6-35b-a3b
KI_LLM_API_BASE=https://api.scaleway.ai/YOUR-PROJECT-ID/v1
KI_LLM_API_KEY=your-scaleway-secret-key

# Embeddings for the dense retrieval leg.
KI_EMBEDDING_MODEL=text-embedding-3-small
KI_EMBEDDING_UPSTREAM=openai/text-embedding-3-small
KI_EMBEDDING_API_KEY=sk-your-openai-key

# ------------------------------------------------------------------- demo model
# What the chat runs on. Separate from the appliance's model on purpose: this one
# reads search results and writes a few paragraphs in front of an audience, so it
# wants to be fast rather than large. Leave unset to reuse KI_LLM_MODEL.
#
# The name must match on both sides — the gateway serves it under KI_DEMO_MODEL
# and the demo asks for it by the same string.
KI_DEMO_MODEL=gemini-3.6-flash
KI_DEMO_UPSTREAM=gemini/gemini-3.6-flash
KI_DEMO_API_KEY=your-gemini-api-key
# Empty for providers that route on the model prefix, which Gemini does.
KI_DEMO_API_BASE=

# ------------------------------------------------------------------------ login
# Optional. Both keys or neither.
#
# Set them and every route — pages, /api/chat, /api/preview — requires a signed-in
# Clerk user. Leave them out and the demo runs open, which is what you want on a
# laptop. A public demo URL without this is a token bill and a document-exposure
# waiting for whichever crawler finds it first.
#
# The secret lives in GCP Secret Manager (project eigenweltlabs-training, secret
# CLERK_SECRET_KEY):
#   gcloud secrets versions access latest --secret=CLERK_SECRET_KEY \
#     --project=eigenweltlabs-training
# The publishable key is not a secret and is not stored there; take it from the
# Clerk dashboard for the same instance, or `clerk env pull`. They must be from
# the same instance — an sk_live with a pk_test fails at the first request.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# The OAuth application MCP clients authenticate against, from Clerk →
# Configure → OAuth Applications. Public/PKCE, so it is not a secret. Only
# needed for clients that cannot register themselves; with dynamic client
# registration enabled on the instance, leave it unset.
# DEMO_OAUTH_CLIENT_ID=
# CLERK_SECRET_KEY=

# ---------------------------------------------------------------------- secrets
# Encrypts stored connector credentials. Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
KI_CONNECTOR_CREDENTIAL_KEY=generate-me-32-bytes-base64

LITELLM_MASTER_KEY=sk-lm-demo-only
KI_POSTGRES_PASSWORD=ki-dev-only

# ---------------------------------------------------------------------- identity
# Who the demo is signed in as. The appliance resolves every folder listing,
# every tool call and every preview against this, so changing it changes what
# the demo can see — which is worth doing live in front of an audience.
#
#   role:admin              sees the whole estate
#   user:ursula@firm.de     sees what that lawyer's grants and mirrored ACLs allow
DEMO_PRINCIPALS=role:admin

# ------------------------------------------------------------------------- ports
# All bound to 127.0.0.1 by the compose file.
DEMO_PORT=3200
KI_APP_PORT=8200
LITELLM_PORT=4200
KI_POSTGRES_PORT=5440

# A host directory to index with the local-folder connector, mounted read-only.
# Defaults to the repository's own testdata.
# KI_LOCAL_MOUNT=/Users/you/Documents/matters
